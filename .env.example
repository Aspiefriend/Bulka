# Порт бэкенда
PORT=3000

# Режим: development | production
NODE_ENV=development

# Секрет для JWT (ОБЯЗАТЕЛЬНО поменять в проде!)
JWT_SECRET=change-me-to-a-long-random-string

# URL фронтенда (только для development, CORS)
CLIENT_URL=http://localhost:5173

# Путь к БД (нужно только в Docker)
# DB_PATH=/app/data/bulka.db